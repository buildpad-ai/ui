# Cookie encryption secret (random string, at least 32 characters).
# REQUIRED in production: the app refuses to read/write the credential
# cookie if it is missing or shorter than 32 characters.
# In development, an insecure default key is used automatically when unset.
# Generate one with: openssl rand -base64 32
COOKIE_SECRET=change-me-to-a-random-string-at-least-32-characters

# Allow-list of DaaS hosts the proxy may connect to (SSRF protection).
# Comma-separated; entries are exact hostnames or "*.suffix" wildcards
# ("*.example.com" matches sub.example.com but not example.com).
# Default when unset: *.buildpad-daas.xtremax.com
# Only https:// URLs are accepted; http://localhost (and 127.0.0.1 / [::1])
# is additionally allowed when NODE_ENV is not "production".
# DAAS_ALLOWED_HOSTS=*.buildpad-daas.xtremax.com,daas.example.org

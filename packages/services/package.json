{
  "name": "@buildpad/services",
  "version": "2.2.0",
  "private": true,
  "description": "Shared service classes for Buildpad projects - DaaS-compatible CRUD services",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./fields": "./src/fields.ts",
    "./collections": "./src/collections.ts",
    "./auth": "./src/auth/index.ts",
    "./auth/session": "./src/auth/session.ts",
    "./auth/enforcer": "./src/auth/enforcer.ts",
    "./auth/filter-to-query": "./src/auth/filter-to-query.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@buildpad/types": "workspace:*",
    "@buildpad/utils": "workspace:*"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2",
    "react": "^18 || ^19",
    "@mantine/dates": "^8.0.0"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2",
    "@types/node": "^22",
    "@types/react": "^19",
    "react": "^19",
    "typescript": "^5.9.3",
    "@mantine/core": "^8.3.9",
    "@mantine/dates": "^8.3.9",
    "@mantine/hooks": "^8.3.9",
    "dayjs": "^1.11.19"
  },
  "peerDependenciesMeta": {
    "@mantine/dates": {
      "optional": true
    }
  }
}

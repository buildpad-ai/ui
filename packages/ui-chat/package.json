{
  "name": "@buildpad/ui-chat",
  "version": "3.6.0",
  "description": "AI chat for Buildpad apps: a docked panel or floating widget that streams answers from a Chocolate Factory agent, with image attachments and annotated screenshots",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --external react --external @mantine/core --external @mantine/hooks --external @tabler/icons-react --external ai --external @ai-sdk/react --external react-markdown --external remark-gfm --external use-stick-to-bottom --external @zumer/snapdom",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --passWithNoTests --coverage",
    "storybook": "storybook dev -p 6015",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "@mantine/core": "^8.0.0",
    "@mantine/hooks": "^8.0.0",
    "@buildpad/services": "workspace:^",
    "@buildpad/utils": "workspace:^",
    "@tabler/icons-react": "^3.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "ai": "^5.0.282",
    "@ai-sdk/react": "^2.0.285",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "use-stick-to-bottom": "^1.1.1",
    "@zumer/snapdom": "^2.24.18"
  },
  "devDependencies": {
    "@ai-sdk/react": "^2.0.285",
    "@buildpad/services": "workspace:*",
    "@buildpad/utils": "workspace:*",
    "@mantine/core": "^8.0.0",
    "@mantine/hooks": "^8.0.0",
    "@mantine/notifications": "^8.0.0",
    "@storybook/addon-a11y": "^10.2.8",
    "@storybook/addon-docs": "^10.2.8",
    "@storybook/addon-links": "^10.2.8",
    "@storybook/nextjs-vite": "^10.2.8",
    "@storybook/react": "^10.2.8",
    "@tabler/icons-react": "^3.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitest/coverage-v8": "2.1.9",
    "@zumer/snapdom": "^2.24.18",
    "ai": "^5.0.282",
    "jsdom": "^25.0.0",
    "next": "^16.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "rimraf": "^6.0.0",
    "storybook": "^10.2.8",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "use-stick-to-bottom": "^1.1.1",
    "vite": "^6.0.0",
    "vitest": "^2.0.0"
  },
  "private": true,
  "keywords": [
    "buildpad",
    "ai",
    "chat",
    "assistant",
    "chocolate-factory",
    "mantine",
    "react"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/buildpad-ai/ui"
  }
}
